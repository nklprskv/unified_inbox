I Gateway + BFF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;auth, RBAC, REST,&lt;br&gt;tenant scoping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="568" y="168" width="168" height="72" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Kafka event log&lt;/b&gt; · keyed by tenant:conversation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#1F6FD1;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="24" y="272" width="532" height="44" as="geometry"/></mxCell><mxCell id="c15" value="Domain services and workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F5F5F5;strokeColor=#D0D0D0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="24" y="340" width="712" height="208" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Conversation Svc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;contact, dedup,&lt;br&gt;messages, outbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;" vertex="1" parent="c15"><mxGeometry x="16" y="32" width="158" height="72" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Outbound Svc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;validate, queue,&lt;br&gt;retries, DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;" vertex="1" parent="c15"><mxGeometry x="190" y="32" width="158" height="72" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Contact Svc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;identities, merge,&lt;br&gt;notes, tags&lt;/font&gt;" style="