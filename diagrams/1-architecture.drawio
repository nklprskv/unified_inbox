<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Every message flows through one Kafka log; PostgreSQL is the source of truth" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="712" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Messaging providers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F5F5F5;strokeColor=#D0D0D0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="24" y="64" width="348" height="72" as="geometry"/></mxCell><mxCell id="c3" value="Twilio SMS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="16" y="32" width="73" height="28" as="geometry"/></mxCell><mxCell id="c4" value="WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="97" y="32" width="73" height="28" as="geometry"/></mxCell><mxCell id="c5" value="Messenger" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="178" y="32" width="73" height="28" as="geometry"/></mxCell><mxCell id="c6" value="Instagram" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontSize=11;" vertex="1" parent="c2"><mxGeometry x="259" y="32" width="73" height="28" as="geometry"/></mxCell><mxCell id="c7" value="Agent apps" style="rounded=1;whiteSpac